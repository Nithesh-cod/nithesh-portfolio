# Copy to .env.local (never commit real values). Add the same keys in Vercel → Settings → Environment Variables.

# Optional, server only. JARVIS AI answers with its built-in AI without this. With a key and credit, Claude
# answers instead, and the built-in AI takes over if Claude ever fails. Set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=
# Optional overrides
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=low

# JARVIS self-learning (all optional). Without storage, JARVIS still remembers visitors
# in their own browser and reads your public GitHub.
# Password for the private review desk (?app=teach, or "sudo teach" in Terminal). 12+ characters.
JARVIS_ADMIN_TOKEN=
# Storage for unanswered questions, reported replies and answers you approve:
# a free Upstash Redis database (Vercel: Storage → Upstash for Redis, which fills in KV_REST_API_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Raises GitHub's rate limit for the repository digest. Read-only public access is enough.
# GITHUB_TOKEN=

# Contact form + JARVIS Mail app (EmailJS, public by design)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
